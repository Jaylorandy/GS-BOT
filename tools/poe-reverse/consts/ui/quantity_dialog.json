  "consts": [
   "BatchExportGateDialog",
   "Batch export interception modal with per-record skip semantics.\n\n    Replaces the old all-or-nothing :class:`QuantityMismatchDialog`. It is fed the\n    pre-scanned batch (see :func:`core.export_gate.scan_batch`) and shows how many\n    records are safe to export vs. how many are blocked, lists each blocked PO with\n    its reasons, then offers three operator choices:\n\n      * ``SKIP``   -> export only the passing records, drop the blocked ones;\n      * ``ALL``    -> export everything (operator owns the risk);\n      * ``CANCEL`` -> abort the whole export (default / safe).\n    ",
   "skip",
   "all",
   "cancel",
   "return",
   "None",
   [
    "return",
    "None"
   ]
  ],
  "n_instructions": 33
 },
