   "Order\\s*#\\s*(\\S+)",
   "^(?P<style>\\S+)\\s+(?P<whse>[A-Z]{2,4})\\s+(?P<desc>.+?)\\s+(?P<ln>\\d+)\\s+(?P<seq>\\d+)\\s+(?P<status>\\S+)\\s+(?P<retail>[\\d.,]+)\\s+(?P<qty>[\\d.,]+)\\s*$",
